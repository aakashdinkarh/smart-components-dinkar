{
	"name": "smart-components-dinkar-monorepo",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"bootstrap": "npm install",
		"dev": "concurrently \"npm run watch --workspace=packages/library\" \"npm run start --workspace=packages/app\"",
		"start": "npm run dev",
		"build": "npm run build:lib && npm run build:app",
		"build:app": "npm run build --workspace=packages/app",
		"build:lib": "npm run build --workspace=packages/library",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --fix",
		"lint:workspaces": "npm run lint --workspaces"
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "5.62.0",
		"@typescript-eslint/parser": "5.62.0",
		"concurrently": "8.0.0",
		"eslint": "8.57.0",
		"eslint-plugin-import": "2.29.0",
		"eslint-plugin-react": "7.34.0",
		"eslint-plugin-react-hooks": "4.6.0"
	}
}
